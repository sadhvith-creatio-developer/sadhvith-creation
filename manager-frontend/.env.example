# Base URL of the FastAPI backend's API routes (same backend the customer
# storefront uses — there is only ONE backend and ONE database).
VITE_API_URL=http://localhost:8000/api

# Public URL of the CUSTOMER storefront, used only for the "View" link in
# the products table so a manager can preview a live product. Optional —
# leave blank and the link will just use a relative path.
VITE_CUSTOMER_SITE_URL=http://localhost:5173
